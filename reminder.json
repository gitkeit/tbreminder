# Reminder テスト用スケジュール（主ファイル）
# 形式: "HH:MM"=毎日 / "YYYY-MM-DD HH:MM"=一回きり / "*:MM"=毎時
# 行頭 # と // はコメントとして無視されます
# 確認観点:
#  - 09:00 毎日の定時通知＋小窓の先頭行
#  - 12:30/18:00 複数件の小窓表示（表示件数設定と連動）
#  - *:30 毎時通知（5分刻みの連打はやめ、1件に削減）
#  - 一回きりは表示確認用（発火テスト時は直近の未来日時に書き換え）
#  - 長文は小窓で省略、Toastで折り返し表示になること
#  - 複数行は小窓で1行目のみ、Toastで全文表示になること
#  - 同時 fire テスト：下の3件（同一時刻の一回きり）が同時に発火し、
#    Toastキューで順番に表示されること。発火後は削除してOK
[
  {"time": "2026-09-10 23:42", "message": "同時テスト1/3：キュー表示の1件目"},
  {"time": "2026-09-10 23:42", "message": "同時テスト2/3：キュー表示の2件目"},
  {"time": "2026-09-10 23:42", "message": "同時テスト3/3：キュー表示の3件目"},
  {"time": "09:00", "message": "おはようございます：今日の予定を確認しましょう"},
  {"time": "12:30", "message": "お昼休みです：少し休憩しましょう"},
  {"time": "14:00", "message": "複数行テスト：1行目\n2行目はToastでのみ確認できます"},


  {"time": "15:00", "message": "長文テスト：このメッセージはわざと長くしています。小窓では末尾が省略され、Toastやホバーでは全文に近い形で読めることを確認します"},
  {"time": "18:00", "message": "退勤前チェック：明日の準備をしましょう"},
  {"time": "*:30", "message": "毎時テスト：姿勢と目を休めましょう"},
  {"time": "2026-12-24 18:00", "message": "一回きりテスト：申込締切のリマインド"},
]
